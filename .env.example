# --- LLM via the Respan gateway (credits handed out at kickoff) -------------
# One Respan key reaches OpenAI, Anthropic, Gemini and 1,000+ models through a
# single OpenAI-compatible endpoint. Keep the "openai/" prefix on the slugs.
LLM_PROVIDER=custom
LLM_ENDPOINT=https://api.respan.ai/api
LLM_API_KEY=<respan-key>
LLM_MODEL=openai/gpt-5-mini

EMBEDDING_PROVIDER=custom
EMBEDDING_ENDPOINT=https://api.respan.ai/api
EMBEDDING_API_KEY=<same-respan-key>
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# Same key for your own agent code (OpenAI SDK base_url=https://api.respan.ai/api)
RESPAN_API_KEY=<respan-key>

# Prefer your own provider instead? Comment the block above and set, e.g.:
# LLM_API_KEY=sk-...
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-5.6-luna

# --- Scalekit AgentKit (Dashboard -> Developers -> API Credentials) ---------
# Connections to create under AgentKit -> Connections: slack, googledrive,
# gmail, github (GitHub pulls files/PRs/issues AND pushes branches/commits/PRs).
SCALEKIT_ENVIRONMENT_URL=https://<env>.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=...

# --- Cognee -----------------------------------------------------------------
# Multi-user mode: per-user datasets, isolated graph + vector stores, shares.
ENABLE_BACKEND_ACCESS_CONTROL=true
# Keep all cognee state inside this folder (handy for a clean reset).
# SYSTEM_ROOT_DIRECTORY=/abs/path/selfheal-demo/.cognee_system
# DATA_ROOT_DIRECTORY=/abs/path/selfheal-demo/.cognee_data
# Optional managed instance instead of local:
# COGNEE_CLOUD_URL=https://your-instance.cognee.ai
# COGNEE_API_KEY=ck_...


# --- hive / self-heal ---------------------------------------------------------
CHECKOUT_ONCALL=oncall-checkout@example.com
BILLING_ONCALL=oncall-billing@example.com
HIVE_USER=hive@example.com
SANITIZER_MODEL=gpt-5-mini
# Sandbox repo the healer ships fixes to (--ship), as the on-call user via Scalekit
GITHUB_OWNER=<your-github-login>
GITHUB_REPO=selfheal-demo
